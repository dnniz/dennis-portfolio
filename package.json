{
  "name": "denn-pineda-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "build": "next build && sh scripts/copy-public.sh",
    "build:ci": "pnpm check && pnpm build",
    "start": "next start",
    "test:e2e": "playwright test",
    "fetch:logos": "bash scripts/fetch-logos.sh"
  },
  "dependencies": {
    "motion": "13.4.6",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^30.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  }
}
