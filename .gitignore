# Dependencias: se instalan en el build, nunca se versionan.
node_modules
.pnpm-store

# Salida de Next. Con `output: "standalone"` son cientos de MB y, peor, son
# ficheros de la maquina que hizo el build. Versionarlos haria que el repo
# creciera en cada push y que una build antigua se colara en la siguiente.
.next
out
build
dist

# TypeScript incremental: cache local, se regenera solo.
*.tsbuildinfo
next-env.d.ts

# Tests y tooling: corren en CI, no forman parte del entregable.
coverage
playwright-report
test-results
blob-report
.playwright

# Secretos. `.env.example` si es/documenta lo que haria falta.
.env
.env.*
!.env.example

# Sistema y editores.
.DS_Store
Thumbs.db
*.pem
.vscode
.idea
*.swp
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
